# Copy to .env (git-ignored). docker compose and the backend both read these.

# ---- Spring ----
SPRING_PROFILES_ACTIVE=dev

# ---- PostgreSQL ----
DB_NAME=examprep
DB_USERNAME=examprep
DB_PASSWORD=examprep
DB_URL=jdbc:postgresql://localhost:5432/examprep
DB_POOL_SIZE=20

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_MAXMEMORY=512mb

# ---- Security ----
# Generate for real environments:  openssl rand -base64 48
JWT_SECRET=ZGV2LW9ubHktc2VjcmV0LWNoYW5nZS1tZS1pbi1wcm9kdWN0aW9uLTAxMjM0NTY3ODk=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
SINGLE_SESSION_ENABLED=false
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Bootstrap admin (created once by Flyway V2; change the password after first login)
ADMIN_EMAIL=admin@examprep.local
ADMIN_INITIAL_PASSWORD=Admin@123

# ---- Exam proctoring ----
# Times a student may leave the test (exit full screen, switch tab/app, minimise) before it is
# submitted automatically on the next one. 2 = auto-submit on the 3rd. 0 = never auto-submit.
MAX_TAB_SWITCHES=2

# ---- URLs ----
FRONTEND_URL=http://localhost:5173

# ---- Email (Mailpit in dev) ----
EMAIL_ENABLED=true
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=false
SMTP_STARTTLS=false
MAIL_FROM=ExamPrep <no-reply@examprep.local>

# ---- Object storage (MinIO in dev, S3 in prod) — used from Phase 2 ----
S3_ENDPOINT=http://localhost:9100
S3_REGION=ap-south-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=examprep
S3_PUBLIC_BASE_URL=http://localhost:9100/examprep
MINIO_API_PORT=9100
MINIO_CONSOLE_PORT=9101
S3_PATH_STYLE=true

# ---- Payments ----
# MOCK (default): no network; use POST /api/v1/payments/{id}/mock-checkout to simulate success.
# RAZORPAY: set the three keys below (test keys start with rzp_test_).
PAYMENT_PROVIDER=MOCK
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- pgAdmin (docker compose --profile tools) ----
PGADMIN_EMAIL=admin@examprep.dev
PGADMIN_PASSWORD=admin
